# ==========================================
# GLOBAL PROJECT CONFIGURATION (.env.example)
# ==========================================

# 1. PATHS & EXECUTION
PYTHONPATH=ml
NODE_ENV=development

# 2. DATABASE (Shared Backend & ML)
# Used by Backend via Prisma/TypeORM/Raw PG
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/ecommerce_ml_db

# Specific breakdown used by ML Python scripts 
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ecommerce_ml_db
DB_USER=postgres
DB_PASS=postgres

# 3. BACKEND (Express)
PORT=5000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
ML_SERVICE_TOKEN=replace_with_at_least_32_random_characters
RETELL_WEBHOOK_SECRET=replace_with_retell_webhook_secret

# 4. EXTERNAL APIs (ML / OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
