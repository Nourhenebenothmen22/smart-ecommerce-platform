# ==========================================
# GLOBAL PROJECT CONFIGURATION (.env.example)
# ==========================================

# 1. PATHS & EXECUTION
PYTHONPATH=ml
NODE_ENV=development

# 2. DATABASE (Shared Backend & ML)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/ecommerce_ml_db

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ecommerce_ml_db
DB_USER=postgres
DB_PASS=postgres

# 3. BACKEND (Express)
PORT=5000
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_here
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# 4. ML SERVICE
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TOKEN=replace_with_at_least_32_random_characters
ML_REQUIRE_SERVICE_TOKEN=false
ML_REQUEST_TIMEOUT_MS=5000

# 5. EXTERNAL APIs
OPENAI_API_KEY=your_openai_api_key_here
ML_ENABLE_LLM_CALLS=false
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# 6. RETELL VOICE
RETELL_WEBHOOK_SECRET=replace_with_retell_webhook_secret
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
WEBHOOK_BASE_URL=

# 7. ML MODELS
PRICE_MODEL_NAME=product_price_prediction
PRICE_MODEL_VERSION=1.0
ML_ALLOW_MODEL_DOWNLOADS=false
ALLOW_UNVERIFIED_CHAT_USER_ID=false
ML_CHAT_RATE_LIMIT_PER_MINUTE=120
ML_PRICE_RATE_LIMIT_PER_MINUTE=60

# 8. MONITORING
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_SMTP_HOST=smtp.gmail.com:587
ALERTMANAGER_SMTP_FROM=benothmennourhen8@gmail.com
ALERTMANAGER_SMTP_USER=
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_RECEIVER_EMAIL=benothmennourhen8@gmail.com
