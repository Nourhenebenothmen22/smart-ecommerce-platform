{
  "venvPath": "ml",
  "venv": ".venv",
  "pythonVersion": "3.14",
  "pythonPlatform": "Windows",
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": false,
  "reportMissingImports": true,
  "include": ["ml"],
  "exclude": [
    "ml/.venv",
    "**/__pycache__",
    "backend",
    "node_modules"
  ],
  "executionEnvironments": [
    {
      "root": "ml",
      "extraPaths": [
        ".",
        "api",
        "scripts",
        "nlp_experiments"
      ]
    }
  ],
  "extraPaths": [
    "./ml"
  ]
}
