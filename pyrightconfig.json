{
  "venvPath": "ml",
  "venv": ".venv",
  "pythonVersion": "3.14",
  "pythonPlatform": "Windows",
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": false,
  "reportMissingImports": true,
  "include": ["ml", "backend"],
  "exclude": ["ml/.venv"],
  "executionEnvironments": [
    {
      "root": "ml",
      "extraPaths": ["."]
    }
  ],
  "extraPaths": ["ml"]
}
